---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Siden ble ikke funnet">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <span class="text-6xl" aria-hidden="true">🧭</span>
    <h1 class="mt-4 font-display text-3xl font-extrabold text-navy">Fant ikke siden</h1>
    <p class="mt-2 text-navy-dark/80">
      Denne siden finnes ikke, eller har blitt flyttet. Kanskje du seilte litt av kurs?
    </p>
    <a
      href="/"
      class="mt-6 inline-flex items-center gap-2 rounded-full bg-navy px-5 py-2 text-sm font-semibold text-white hover:bg-navy-dark"
    >
      Tilbake til forsiden
    </a>
  </section>
</Layout>
