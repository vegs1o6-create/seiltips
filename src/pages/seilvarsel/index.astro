---
import Layout from '../../layouts/Layout.astro';
import SeilvarselCard from '../../components/SeilvarselCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('seilvarsel', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Seilruteplan Oslofjorden–Kosterøyene"
  description="Automatisk ruteplanlegging for seilas mellom Oslo og Kosterøyene, basert på værvarsel og oppdatert hver 3. dag."
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-3xl font-extrabold text-navy sm:text-4xl">Seilruteplan</h1>
    <p class="mt-2 max-w-2xl text-navy-dark/80">
      En AI-generert ruteplanlegger analyserer værvarselet for strekningen Oslo–Drøbak–Færder–
      Hvaler–Kosterøyene hver 3. dag, og gir anbefalinger om seilføring, timing og
      seilingsvindu. Erstatter ikke offisielle farevarsler – se alltid
      <a href="https://www.yr.no" class="underline hover:text-sky" target="_blank" rel="noopener noreferrer">yr.no</a>
      og <a href="https://varsom.no" class="underline hover:text-sky" target="_blank" rel="noopener noreferrer">varsom.no</a>
      før du legger ut på tur.
    </p>

    {
      allPosts.length === 0 ? (
        <p class="mt-10 text-navy-dark/70">Ingen ruteplaner er publisert ennå. Kom tilbake snart!</p>
      ) : (
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {allPosts.map((post) => (
            <SeilvarselCard post={post} />
          ))}
        </div>
      )
    }
  </section>
</Layout>
