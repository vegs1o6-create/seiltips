---
import Layout from '../../layouts/Layout.astro';
import { findImage } from '../../utils/images';

interface Harbor {
  name: string;
  slug: string;
  area: string;
  innseiling: string;
  fasiliteter: string;
  ly: string;
  tips: string;
}

const harborGroups: { area: string; harbors: Harbor[] }[] = [
  {
