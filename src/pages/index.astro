---
import Layout from '../layouts/Layout.astro';
import WindyMap from '../components/WindyMap.astro';
import { getCollection } from 'astro:content';

const allArticles = (await getCollection('artikler', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [latest, ...rest] = allArticles;
const recentArticles = rest.slice(0, 5);

const formatDate = (date: Date) =>
  date.toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' });

const ctaButtons = [
  {
    href: '/artikler/slik-kjoper-du-brukt-seilbaat',
    iconSrc: '/icons/kjopshjelp.png',
    title: 'Kjøpshjelp',
    description: 'Kjøpsguide: Slik kjøper du brukt seilbåt',
    style: 'bg-mint-dark text-navy hover:bg-mint',
  },
  {
    href: '/seilvarsel',
    iconSrc: '/icons/seilrute.png',
    title: 'Seilruteplan',
    description: 'Når bør du dra ut? Ruteplan og timing for Oslofjorden til Kosterøyene',
    style: 'bg-sky hover:bg-sky-dark',
  },
  {
    href: '/seiling-1-2-3',
    iconSrc: '/icons/opplaering.png',
    title: 'Seiling 1-2-3',
    description: 'Grunnleggende tips for nye seilere',
    style: 'bg-mint text-navy hover:bg-mint-dark',
  },
  {
    href: '/baater',
    iconSrc: '/icons/logo.png',
    title: 'Båter',
    description: 'Båttyper, utstyr og vedlikehold',
    style: 'bg-sky hover:bg-sky-dark',
  },
];
---

<Layout title="Forside" description="Værvarsel og seiltips for Oslofjorden til Kosterøyene – samlet på ett sted.">
  <section class="relative bg-navy bg-[url('/bakgrunn.webp')] bg-cover bg-[center_70%] text-white lg:bg-[length:140%_auto] lg:bg-[position:0%_65%]">
    <div class="absolute inset-0 bg-gradient-to-r from-navy/90 via-navy/50 to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto flex min-h-80 max-w-6xl flex-col justify-center px-4 lg:[&>*]:max-w-md py-12 sm:min-h-96 sm:px-6">
      <h1 class="font-display text-2xl font-extrabold tracking-tight sm:text-3xl lg:text-4xl">Klar for en ny dag på sjøen?</h1>
      <p class="mt-3 max-w-2xl text-white/80">
        Seiltips.no samler værvarsel og praktiske seiltips for deg som ferdes fra Oslofjorden og ned til
        Kosterøyene – enten du er nybegynner eller erfaren skipper.
      </p>
    </div>
  </section>

  {
    latest && (
      <section class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 sm:pt-16">
        <a
          href={`/artikler/${latest.id}`}
          class="group flex flex-col gap-4 rounded-3xl bg-white p-6 shadow-card ring-1 ring-navy/10 transition-colors hover:bg-cloud sm:p-8 lg:flex-row lg:items-center lg:justify-between lg:gap-10 lg:p-10"
        >
          <div class="lg:max-w-2xl">
            <span class="inline-flex items-center rounded-full bg-mint/30 px-4 py-1 text-xs font-bold uppercase tracking-wide text-navy">
              Siste artikkel
            </span>
            <time datetime={latest.data.pubDate.toISOString()} class="mt-4 block text-sm font-semibold text-sky">
              {formatDate(latest.data.pubDate)}
            </time>
            <h2 class="mt-2 font-display text-2xl font-extrabold tracking-tight text-navy sm:text-3xl lg:text-4xl">
              {latest.data.title}
            </h2>
            <p class="mt-3 max-w-xl text-navy-dark/80">{latest.data.description}</p>
          </div>
          <span class="inline-flex shrink-0 items-center gap-1 self-start rounded-full bg-navy px-5 py-2 text-sm font-semibold text-white transition-transform group-hover:translate-x-1">
            Les hele saken
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </span>
        </a>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:pb-10">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div class="min-w-0">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:h-full lg:auto-rows-fr lg:gap-4">
          {
            ctaButtons.map((cta) => (
              <a
                href={cta.href}
                class:list={[
                  'flex min-w-0 flex-col items-center gap-1 rounded-2xl px-4 py-4 text-center font-semibold text-white shadow-soft transition-transform hover:-translate-y-1 lg:justify-center lg:gap-2 lg:px-6 lg:py-8',
                  cta.style,
                ]}
              >
                <img src={cta.iconSrc} alt="" class="h-10 w-10 object-contain sm:h-14 sm:w-14 lg:h-20 lg:w-20" aria-hidden="true" />
                <span class="font-display text-sm lg:text-lg">{cta.title}</span>
                <span class="text-xs font-normal opacity-90 lg:text-sm">{cta.description}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="min-w-0">
        <h2 class="font-display text-2xl font-bold text-navy sm:text-3xl">Siste artikler</h2>

        {
          recentArticles.length > 0 ? (
            <ul class="mt-6 divide-y divide-navy/10 overflow-hidden rounded-2xl bg-white shadow-card">
              {recentArticles.map((post) => (
                <li>
                  <a
                    href={`/artikler/${post.id}`}
                    class="group flex items-center justify-between gap-4 px-5 py-4 transition-colors hover:bg-cloud"
                  >
                    <div class="min-w-0">
                      <time datetime={post.data.pubDate.toISOString()} class="text-xs font-semibold uppercase tracking-wide text-sky">
                        {formatDate(post.data.pubDate)}
                      </time>
                      <h3 class="mt-1 truncate font-display font-bold text-navy group-hover:text-sky">
                        {post.data.title}
                      </h3>
                    </div>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 shrink-0 text-sky transition-transform group-hover:translate-x-1"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-6 text-navy-dark/70">Flere artikler kommer snart!</p>
          )
        }

        <a href="/artikler" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-sky hover:text-sky-dark">
          Se alle artikler
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-2">
      <div>
        <h2 class="font-display text-2xl font-bold text-navy sm:text-3xl">Værkart</h2>
        <p class="mt-1 max-w-xl text-sm text-navy-dark/70">
          Live vind- og værkart for Oslofjorden til Kosterøyene, levert av Windy.com.
        </p>
      </div>
      <a href="/vaer" class="text-sm font-semibold text-sky hover:text-sky-dark">Se 7-dagers varsel →</a>
    </div>
    <WindyMap />
  </section>
</Layout>
