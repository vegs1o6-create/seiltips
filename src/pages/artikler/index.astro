---
import Layout from '../../layouts/Layout.astro';
import ArtikkelCard from '../../components/ArtikkelCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('artikler', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const plainText = (md: string) =>
  md
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#*_`>|~-]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const searchText = (post: (typeof allPosts)[number]) =>
  [post.data.title, post.data.description, (post.data.tags ?? []).join(' '), plainText(post.body ?? '')]
    .join(' ')
    .toLowerCase();

const monthFormat = new Intl.DateTimeFormat('nb-NO', { month: 'long', year: 'numeric', timeZone: 'Europe/Oslo' });
const monthKey = (d: Date) => {
  const parts = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit', timeZone: 'Europe/Oslo' }).format(d);
  return parts.slice(0, 7);
};

const groups: { key: string; label: string; posts: typeof allPosts }[] = [];
for (const post of allPosts) {
  const key = monthKey(post.data.pubDate);
  let group = groups.find((g) => g.key === key);
  if (!group) {
    const label = monthFormat.format(post.data.pubDate);
    group = { key, label: label.charAt(0).toUpperCase() + label.slice(1), posts: [] };
    groups.push(group);
  }
  group.posts.push(post);
}
---

<Layout title="Artikler" description="Utdypende artikler om seiling, vær, sikkerhet og båtliv langs norskekysten.">
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-3xl font-extrabold text-navy sm:text-4xl">Artikler</h1>
    <p class="mt-2 max-w-2xl text-navy-dark/80">
      Utdypende artikler om seiling, vær, sikkerhet og båtliv – for deg som vil lære mer.
    </p>

    {
      allPosts.length === 0 ? (
        <p class="mt-10 text-navy-dark/70">Ingen artikler er publisert ennå. Kom tilbake snart!</p>
      ) : (
        <>
          <div class="mt-8 max-w-xl">
            <label for="artikkel-sok" class="sr-only">Søk i artikler</label>
            <div class="relative">
              <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-navy-dark/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" />
              </svg>
              <input
                id="artikkel-sok"
                type="search"
                autocomplete="off"
                placeholder="Søk i artikler …"
                class="w-full rounded-full border border-navy/15 bg-white py-3 pl-10 pr-4 text-navy-dark shadow-card focus:border-sky focus:outline-none focus:ring-2 focus:ring-sky/30"
              />
            </div>
            <p id="sok-status" class="mt-2 min-h-5 text-sm text-navy-dark/70" aria-live="polite" />
          </div>

          <div id="artikkel-grupper" class="mt-8 space-y-4">
            {groups.map((group, i) => (
              <details class="artikkel-gruppe group/mnd rounded-2xl bg-white/60 shadow-card" open={i === 0} data-default-open={i === 0 ? 'true' : 'false'}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-2xl px-5 py-4 font-display text-lg font-bold text-navy hover:text-sky [&::-webkit-details-marker]:hidden">
                  <span>
                    {group.label}
                    <span class="ml-2 text-sm font-semibold text-navy-dark/60">
                      (<span class="gruppe-antall">{group.posts.length}</span>)
                    </span>
                  </span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 transition-transform group-open/mnd:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="grid gap-6 px-5 pb-5 sm:grid-cols-2 lg:grid-cols-3">
                  {group.posts.map((post) => (
                    <div class="artikkel-item" data-search={searchText(post)}>
                      <ArtikkelCard post={post} />
                    </div>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </>
      )
    }
  </section>
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>('#artikkel-sok');
  const status = document.querySelector<HTMLElement>('#sok-status');
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>('.artikkel-gruppe'));

  function update() {
    const terms = (input?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean);
    const searching = terms.length > 0;
    let total = 0;

    for (const group of groups) {
      let matches = 0;
      group.querySelectorAll<HTMLElement>('.artikkel-item').forEach((item) => {
        const hay = item.dataset.search ?? '';
        const hit = terms.every((t) => hay.includes(t));
        item.hidden = !hit;
        if (hit) matches++;
      });
      total += matches;
      group.hidden = searching && matches === 0;
      group.open = searching ? matches > 0 : group.dataset.defaultOpen === 'true';
      const count = group.querySelector('.gruppe-antall');
      if (count) count.textContent = String(matches);
    }

    if (status) {
      status.textContent = !searching
        ? ''
        : total === 0
          ? 'Ingen artikler matchet søket.'
          : `${total} ${total === 1 ? 'artikkel' : 'artikler'} funnet`;
    }
  }

  input?.addEventListener('input', update);
</script>
