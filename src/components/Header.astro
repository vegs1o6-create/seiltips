---
const navLinks = [
  { href: '/', label: 'Forside' },
  { href: '/nyheter', label: 'Nyhetsarkiv' },
  { href: '/vaer', label: 'Vær' },
  { href: '/seiling-1-2-3', label: 'Seiling 1-2-3' },
  { href: '/baater', label: 'Båter' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 bg-navy text-white shadow-soft">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-display text-xl font-bold tracking-tight">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-2xl bg-mint text-navy shadow-card"
        aria-hidden="true">⛵</span
      >
      <span>Seiltips<span class="text-mint">.no</span></span>
    </a>

    <nav aria-label="Hovedmeny" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          navLinks.map((link) => {
            const isActive =
              link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'block rounded-full px-4 py-2 text-sm font-semibold transition-colors',
                    isActive
                      ? 'bg-white text-navy'
                      : 'text-white/90 hover:bg-white/10 hover:text-white',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <details class="relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center justify-center rounded-full bg-white/10 p-2"
        aria-label="Åpne meny"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <ul class="absolute right-0 mt-2 w-48 space-y-1 rounded-2xl bg-white p-2 text-navy shadow-card">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="block rounded-xl px-4 py-2 text-sm font-semibold hover:bg-cloud">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</header>
